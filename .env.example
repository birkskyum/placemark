# Mapbox token for the current renderer and default basemaps
# from https://account.mapbox.com/
VITE_PUBLIC_MAPBOX_TOKEN=xxx
# Geocode Earth token for geocoding/search
# from https://app.geocode.earth/
VITE_PUBLIC_GEOCODE_EARTH_TOKEN=xxx

# Optional routing. See docs/routing.md for other providers.
# VITE_PUBLIC_ROUTING_PROVIDER=openrouteservice
# VITE_PUBLIC_ROUTING_API_KEY=xxx
